{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed exact skill collections",
  "type": "object", "required": ["schema_version", "collections"],
  "properties": {
    "schema_version": { "const": 1 },
    "collections": { "type": "array", "items": {
      "type": "object", "required": ["id", "repository", "branch", "reviewed_revision", "skills"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "repository": { "type": "string" }, "branch": { "type": "string" },
        "reviewed_revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } }
      }
    } }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "skill": {
      "type": "object", "required": ["id", "root", "license", "license_path", "license_digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "root": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "pattern": "^(MIT|Apache-2.0|CC-BY-2.0|CC-BY-4.0|GPL-3.0-only|CC-BY-SA-4.0)( AND (MIT|Apache-2.0|CC-BY-2.0|CC-BY-4.0|GPL-3.0-only|CC-BY-SA-4.0))*$" },
        "reviewed_distribution": {
          "type": "object", "required": ["version", "files"], "additionalProperties": false,
          "properties": {
            "version": { "const": 1 },
            "native": { "type": "object", "required": ["files", "hook_configs"], "additionalProperties": false, "properties": { "files": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }, "hook_configs": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
            "files": { "type": "object", "minProperties": 1, "additionalProperties": {
              "type": "object", "required": ["digest", "mode", "output"], "additionalProperties": false,
              "properties": { "digest": { "$ref": "#/$defs/digest" }, "mode": { "enum": ["100644", "100755"] }, "output": { "type": "string" }, "change_notice": { "type": "string", "pattern": "^Forge distribution notice:" } }
            } },
            "supplements": { "type": "object", "additionalProperties": {
              "type": "object", "required": ["digest", "output", "source", "license"], "additionalProperties": false,
              "properties": { "digest": { "$ref": "#/$defs/digest" }, "output": { "type": "string" }, "source": { "type": "string" }, "license": { "type": "string" }, "artifact": { "type": "object", "required": ["digest", "member", "integrity"], "additionalProperties": false, "properties": { "digest": { "$ref": "#/$defs/digest" }, "member": { "type": "string" }, "integrity": { "type": "string", "pattern": "^sha512-" } } } }
            } },
            "obligations": { "type": "array", "items": {
              "type": "object", "required": ["license", "files", "notices", "attribution", "source"], "additionalProperties": false,
              "properties": { "license": { "type": "string" }, "files": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "notices": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "attribution": { "type": "string", "minLength": 1 }, "source": { "type": "string" } }
            } }
          }
        },
        "license_path": { "type": "string" }, "license_digest": { "$ref": "#/$defs/digest" },
        "attribution": { "type": "string" },
        "reviewed_templates": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } },
        "reviewed_documents": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } },
        "reviewed_guide": {
          "type": "object", "required": ["name", "path", "source_digest", "adapter_version"],
          "properties": {
            "name": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 },
            "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "adapter_version": { "const": 1 }
          }, "additionalProperties": false
        },
        "reviewed_design": {
          "type": "object", "required": ["name", "source_digest", "adapter_version"],
          "properties": {
            "name": { "$ref": "#/$defs/id" },
            "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "adapter_version": { "const": 1 }
          }, "additionalProperties": false
        },
        "reviewed_name": {
          "type": "object", "required": ["source_name", "name", "source_digest"],
          "properties": {
            "source_name": { "type": "string", "minLength": 1 },
            "name": { "$ref": "#/$defs/id" },
            "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "notices": { "type": "array", "items": {
          "type": "object", "required": ["path", "digest", "source", "license"],
          "properties": { "path": { "type": "string", "pattern": "^registry/licenses/" }, "digest": { "$ref": "#/$defs/digest" }, "source": { "type": "string", "pattern": "^https://github.com/" }, "license": { "type": "string" } }
        } }
      },
      "allOf": [{ "if": { "properties": { "license_path": { "const": "" } } }, "then": { "required": ["notices"], "properties": { "notices": { "minItems": 1 } } } }]
    }
  }
}
