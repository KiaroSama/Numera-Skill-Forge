{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KiaroSama/Numera-Skill-Forge/registry.schema.json",
  "title": "Forge source and package registry",
  "type": "object",
  "required": ["schema_version", "sources", "packages"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" } }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object", "required": ["id", "repository"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "repository": { "type": "string" },
        "enabled": { "type": "boolean", "default": false },
        "roots": { "$ref": "#/$defs/strings" }, "excludes": { "$ref": "#/$defs/strings" },
        "targets": { "$ref": "#/$defs/strings" },
        "update": { "enum": ["review", "approved-content-only", "pinned"] },
        "reference": {
          "type": "object", "required": ["strategy"],
          "properties": { "strategy": { "enum": ["default-branch", "branch", "commit", "tag", "latest-stable-release"] }, "value": { "type": "string" } },
          "allOf": [{ "if": { "properties": { "strategy": { "enum": ["branch", "commit", "tag"] } } }, "then": { "required": ["value"] } }]
        },
        "metadata": {
          "type": "object",
          "properties": { "provider_policy": { "$ref": "#/$defs/provider_policy" }, "ssh_authentication": { "$ref": "#/$defs/ssh_authentication" } }
        },
        "credential_reference": {
          "type": ["string", "null"], "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Explicit caller environment key containing Basic or Bearer authorization. The value stays off process arguments, configuration and logs; offline access needs no credential."
        }
      }
    },
    "ssh_authentication": {
      "type": "object", "additionalProperties": false,
      "required": ["public_key_reference", "known_hosts_reference", "agent_reference"],
      "properties": {
        "public_key_reference": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "known_hosts_reference": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "agent_reference": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
      }
    },
    "provider_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["transport", "host", "reviewed"],
      "properties": {
        "transport": { "enum": ["https", "ssh"] },
        "host": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9.-]+$" },
        "reviewed": { "const": true }
      },
      "description": "Explicit review of exact repository DNS host and transport; no wildcards. SSH registration is not acquisition support."
    },
    "package": {
      "type": "object", "required": ["id", "name", "source", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "source": { "$ref": "#/$defs/id" },
        "components": { "$ref": "#/$defs/strings" }, "dependencies": { "$ref": "#/$defs/strings" },
        "targets": { "$ref": "#/$defs/strings" }, "optional_exclusions": { "$ref": "#/$defs/strings" }
      }
    }
  }
}
